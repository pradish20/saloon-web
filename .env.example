# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION (Optional for live Supabase sync)
# Provide your Supabase project URL and anon public key.
# The app includes an out-of-the-box in-memory/localStorage fallback mode
# so you can test booking, admin management, and live editing immediately.
# When ready for live multi-device database and Supabase Auth, provide these keys:
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"
